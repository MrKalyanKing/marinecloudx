# ==========================================
# MarineCloudX frontend — environment
# ==========================================
#
# The README tells you to `cp .env.example .env`, but this file did not exist
# until now. Copy it, then fill in the values for your environment.

# --- API -----------------------------------------------------------------
# Base URL of the NestJS backend. Every public read goes through it.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Site identity -------------------------------------------------------
# Canonical origin, used for every canonical URL, og:url, sitemap <loc> and the
# robots.txt Sitemap line. In production this may be omitted: src/lib/config/site.ts
# falls back to https://marinecloudx.in rather than to localhost. Set it anyway
# so the value is explicit, and set it for staging so staging never claims the
# production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Media ---------------------------------------------------------------
# Comma-separated hostnames allowed to serve CMS images, consumed by
# next.config.ts to build `images.remotePatterns`.
#
# REQUIRED IN PRODUCTION if media lives anywhere other than the API host.
# next/image refuses any remote host not listed here, so an unset value shows
# no CMS imagery at all. The API hostname is always added automatically.
# Example: NEXT_PUBLIC_MEDIA_HOSTS=media.marinecloudx.in,cdn.example-storage.com
NEXT_PUBLIC_MEDIA_HOSTS=

# --- Server-only ---------------------------------------------------------
# Shared secret the backend presents to POST /api/revalidate after a CMS
# publish or unpublish. Must match apps/backend/.env.
#
# This is what makes cached pages safe: the public segment is rendered with
# `revalidate = 300` (src/app/(public)/layout.tsx), and this webhook is what
# takes unpublished content down immediately rather than up to five minutes
# later. Do not deploy without it.
REVALIDATE_SECRET=
