# ==========================================
# MarineCloudX frontend — environment
# ==========================================
#
# The README tells you to `cp .env.example .env`, but this file did not exist
# until now. Copy it, then fill in the values for your environment.

# --- API -----------------------------------------------------------------
# Base URL of the NestJS backend. Every public read goes through it.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Site identity -------------------------------------------------------
# Canonical origin, used for every canonical URL, og:url, og:image, sitemap
# <loc> and the robots.txt Sitemap line.
#
# SET THIS PER VERCEL ENVIRONMENT. It is the whole fix for the link preview bug:
#
#   Production  ->  https://marinecloudx.in
#   Preview     ->  https://dev-frontend.marinecloudx.in
#   Development ->  http://localhost:3000
#
# Why it matters. `og:image` is a fully-qualified URL built from this origin, so
# an unset value on the preview deployment made dev-frontend.marinecloudx.in
# advertise https://marinecloudx.in/opengraph-image.png — the *old* site still
# answering on the apex. WhatsApp, Slack and Twitter fetched that URL and drew
# its SMIVORA artwork beside this site's title and description.
#
# src/lib/config/site.ts now falls back to the deployment's own Vercel host
# rather than to the apex, so an unset value no longer points at another
# website. That is a safety net, not a substitute: only this variable produces
# the custom domain rather than the *.vercel.app one.
#
# Scope it correctly. A variable scoped only to Development is never used on a
# cloud build (see DEPLOYMENT_TROUBLESHOOTING.md #5), which is exactly how it
# ends up unset on preview without anyone noticing.
#
# After changing it: redeploy, then re-scrape the link. WhatsApp and Facebook
# cache a preview per URL for days. The image URL carries a content hash and so
# changes with the file, but og:url and og:title do not — clear the Facebook
# cache at https://developers.facebook.com/tools/debug/ to see the new preview
# immediately.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Media ---------------------------------------------------------------
# Comma-separated hostnames allowed to serve CMS images, consumed by
# next.config.ts to build `images.remotePatterns`.
#
# REQUIRED IN PRODUCTION if media lives anywhere other than the API host.
# next/image refuses any remote host not listed here, so an unset value shows
# no CMS imagery at all. The API hostname is always added automatically.
# Example: NEXT_PUBLIC_MEDIA_HOSTS=media.marinecloudx.in,cdn.example-storage.com
NEXT_PUBLIC_MEDIA_HOSTS=

# --- Server-only ---------------------------------------------------------
# Shared secret the backend presents to POST /api/revalidate after a CMS
# publish or unpublish. Must match apps/backend/.env.
#
# This is what makes cached pages safe: the public segment is rendered with
# `revalidate = 300` (src/app/(public)/layout.tsx), and this webhook is what
# takes unpublished content down immediately rather than up to five minutes
# later. Do not deploy without it.
REVALIDATE_SECRET=
